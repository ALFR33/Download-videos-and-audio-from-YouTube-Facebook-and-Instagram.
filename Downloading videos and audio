<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مُحمِّل الميديا الشامل | تنزيل من 7 منصات عالمية</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    sans: ['Segoe UI', 'Tahoma', 'Geneva', 'Verdana', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between font-sans transition-colors duration-300">

    <!-- Toast Notification -->
    <div id="toast" class="hidden fixed bottom-6 right-6 z-50 flex items-center gap-3 px-5 py-3.5 bg-slate-900 border border-cyan-500/50 text-white rounded-2xl shadow-2xl text-sm font-bold animate-bounce">
        <i class="fa-solid fa-circle-check text-cyan-400 text-lg"></i>
        <span id="toast-message">تم الاستخراج بنجاح!</span>
    </div>

    <!-- Header / Navbar -->
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <!-- Logo -->
                <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('single')">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-pink-500 p-0.5 shadow-lg shadow-indigo-500/30 flex items-center justify-center">
                        <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
                            <i class="fa-solid fa-download text-cyan-400 text-xl"></i>
                        </div>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-2xl font-black bg-gradient-to-r from-cyan-400 via-indigo-300 to-pink-400 bg-clip-text text-transparent">
                                مُحمِّل الميديا
                            </span>
                            <span class="px-2 py-0.5 text-[10px] font-extrabold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 rounded-full">PRO</span>
                        </div>
                        <p class="text-xs text-slate-400 font-medium">تنزيل من 7 منصات عالمية بدون علامة مائية</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex items-center gap-1 bg-slate-800/80 p-1.5 rounded-2xl border border-slate-700/60">
                    <button onclick="switchTab('single')" id="nav-single" class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 text-white shadow-md">
                        <i class="fa-solid fa-bolt"></i> تحميل سريع
                    </button>
                    <button onclick="switchTab('batch')" id="nav-batch" class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-700/50">
                        <i class="fa-solid fa-layer-group"></i> تحميل متعدد
                    </button>
                    <button onclick="switchTab('history')" id="nav-history" class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-slate-300<i class="fa-solid fa-clock-rotate-left"></i> السجل (<span id="history-count">0</span>)
                    </button>
                    <button onclick="switchTab('guide')" id="nav-guide" class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-700/50">
                        <i class="fa-solid fa-shield-halved"></i> شرح المنصات
                    </button>
                </nav>

                <!-- Status Badge -->
                <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span>السيرفرات تعمل 100%</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

        <!-- Hero Section -->
        <div id="hero-section" class="text-center max-w-4xl mx-auto space-y-4 mb-8 pt-4">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900 border border-slate-800 text-xs font-extrabold text-cyan-300">
                <i class="fa-solid fa-fire text-rose-400"></i>
                <span>موقع التحميل الأول المباشر لكل المنصات 2026</span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight">
                تنزيل الفيديوهات والصوتيات من <br>
                <span class="bg-gradient-to-r from-cyan-400 via-indigo-400 to-pink-400 bg-clip-text text-transparent">جميع المنصات العالمية</span>
            </h1>

            <p class="text-slate-400 font-medium max-w-2xl mx-auto text-sm sm:text-base">
                قم بتحميل المقاطع والموسيقى بجودة عالية تصل إلى <span class="text-cyan-300 font-bold">4K و 1080p</span> وبدون أي علامة مائية بضغطة زر واحدة.
            </p>
        </div>

        <!-- Single Downloader View -->
        <div id="view-single" class="space-y-6">
            <!-- Platform Filter Bar -->
            <div class="flex items-center gap-2 overflow-x-auto pb-3 scrollbar-none">
                <button onclick="selectPlatform('all')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-gradient-to-r from-slate-800 to-slate-900 text-white border border-cyan-500 shadow-md">
                    <i class="fa-solid fa-globe text-cyan-400"></i> الكل (7)
                </button>
                <button onclick="selectPlatform('youtube')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-brands fa-youtube text-red-500"></i> يوتيوب
                </button>
                <button onclick="selectPlatform('tiktok')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-brands fa-tiktok text-cyan-400"></i> تيك توك
                </button>
                <button onclick="selectPlatform('instagram')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-brands fa-instagram text-pink-500"></i> إنستغرام
                </button>
                <button onclick="selectPlatform('facebook')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-brands fa-facebook text-blue-500"></i> فيسبوك
                </button>
                <button onclick="selectPlatform('telegram')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-brands fa-telegram text-sky-400"></i> تيليجرام
                </button>
                <button onclick="selectPlatform('twitter')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-brands fa-x-twitter text-slate-300"></i> تويتر
                </button>
                <button onclick="selectPlatform('likee')" class="platform-chip flex items-center gap-2 px-4 py-2.5 rounded-2xl text-sm font-bold bg-slate-900 text-slate-400 border border-slate-800 hover:text-white">
                    <i class="fa-solid fa-wand-magic-sparkles text-rose-400"></i> ليكي
                </button>
            </div>

            <!-- Main Input Form -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
                <form onsubmit="handleAnalyze(event)" class="space-y-4">
                    <label class="text-base font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-cyan-400"></i>
                        <span>ضع رابط الفيديو أو الصوت للبدء:</span>
                    </label>

                    <div class="relative flex items-center bg-slate-950 rounded-2xl border border-slate-700/80 p-2 focus-within:border-cyan-400 transition-all">
                        <input id="url-input" type="url" dir="ltr" placeholder="https://www.youtube.com/watch?v=... أو TikTok / Reels" required
                            class="w-full bg-transparent px-4 py-3 text-white placeholder-slate-500 focus:outline-none text-base font-medium">
                        
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="pasteClipboard()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all border border-slate-700 whitespace-nowrap">
                                <i class="fa-regular fa-clipboard text-cyan-400 ml-1"></i> لصق
                            </button>

                            <button type="submit" id="btn-submit" class="flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 via-indigo-600 to-pink-500 hover:from-cyan-400 hover:to-pink-400 text-white font-extrabold text-base shadow-lg transition-all whitespace-nowrap">
                                <span>تحميل الآن</span>
                                <i class="fa-solid fa-arrow-left"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Media Result Card (Dynamic Container) -->
            <div id="media-result-container"></div>
        </div>

        <!-- Batch View -->
        <div id="view-batch" class="hidden bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-4">
            <h2 class="text-xl font-extrabold text-white"><i class="fa-solid fa-layer-group text-cyan-400 ml-2"></i> تحميل روابط متعددة</h2>
            <p class="text-xs text-slate-400">ضع رابط فيديو في كل سطر لتحميل عدة مقاطع دفعة واحدة:</p>
            <textarea id="batch-input" rows="6" dir="ltr" placeholder="https://www.youtube.com/watch?v=...\nhttps://www.tiktok.com/@user/video/..." 
                class="w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 text-white font-mono text-sm focus:outline-none focus:border-cyan-500"></textarea>
            <button onclick="processBatch()" class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-extrabold rounded-xl shadow-lg">
                معالجة وتحميل الكل
            </button>
            <div id="batch-results" class="space-y-3 pt-4"></div>
        </div>

        <!-- History View -->
        <div id="view-history" class="hidden bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                <h2 class="text-xl font-extrabold text-white"><i class="fa-solid fa-clock-rotate-left text-pink-400 ml-2"></i> سجل التنزيلات السابق</h2>
                <button onclick="clearHistory()" class="px-3 py-1.5 bg-rose-500/20 text-rose-300 rounded-xl text-xs font-bold border border-rose-500/30">
                    <i class="fa-solid fa-trash ml-1"></i> مسح السجل
                </button>
            </div>
            <div id="history-items-container" class="space-y-3"></div>
        </div>

        <!-- Guide View -->
        <div id="view-guide" class="hidden bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 space-y-6">
            <h2 class="text-xl font-extrabold text-white">طريقة نسِخ الرابط من المنصات 7</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="p-4 bg-slate-950 border border-slate-800 rounded-2xl space-y-2">
                    <h3 class="font-bold text-red-400"><i class="fa-brands fa-youtube ml-1"></i> يوتيوب</h3>
                    <p class="text-xs text-slate-400">افتح الفيديو واضغط مشاركة (Share) ثم نسخ الرابط.</p>
                </div>
                <div class="p-4 bg-slate-950 border border-slate-800 rounded-2xl space-y-2">
                    <h3 class="font-bold text-cyan-400"><i class="fa-brands fa-tiktok ml-1"></i> تيك توك</h3>
                    <p class="text-xs text-slate-400">اختر مشاركة الفيديو ثم "نسخ الرابط" للتنزيل بدون علامة مائية.</p>
                </div>
                <div class="p-4 bg-slate-950 border border-slate-800 rounded-2xl space-y-2">
                    <h3 class="font-bold text-pink-400"><i class="fa-brands fa-instagram ml-1"></i> إنستغرام</h3>
                    <p class="text-xs text-slate-400">من النقاط الثلاث أعلى مقطع الريلز اختر "انسخ الرابط".</p>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-6 bg-slate-950 text-center text-xs text-slate-500">
        <p>مُحمِّل الميديا الشامل © 2026 - تنزيل الفيديوهات والصوتيات بأعلى جودة</p>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        let currentPlatform = 'all';
        let history = JSON.parse(localStorage.getItem('media_downloader_history') || '[]');

        function updateHistoryCount() {
            document.getElementById('history-count').innerText = history.length;
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3500);
        }

        function switchTab(tab) {
            ['single', 'batch', 'history', 'guide'].forEach(t => {
                document.getElementById(`view-${t}`).classList.add('hidden');
                document.getElementById(`nav-${t}`)?.classList.remove('bg-gradient-to-r', 'from-cyan-500', 'to-blue-600', 'text-white');
                document.getElementById(`nav-${t}`)?.classList.add('text-slate-300');
            });

            document.getElementById(`view-${tab}`).classList.remove('hidden');
            document.getElementById(`nav-${tab}`)?.classList.add('bg-gradient-to-r', 'from-cyan-500', 'to-blue-600', 'text-white');
            
            if (tab === 'history') renderHistory();
        }

        function selectPlatform(p) {
            currentPlatform = p;
            showToast(`تم تغيير المنصة المفضلة إلى: ${p.toUpperCase()}`);
        }

        async function pasteClipboard() {
            try {
                const text = await navigator.clipboard.readText();
                if (text) document.getElementById('url-input').value = text;
            } catch (e) {
                showToast("الرجاء إعطاء صلاحية لصق الحافظة للمتصفح");
            }
        }

        function handleAnalyze(e) {
            e.preventDefault();
            const url = document.getElementById('url-input').value.trim();
            if (!url) return;

            showToast("جاري تحليل الرابط واستخراج خيارات التحميل...");
            
            setTimeout(() => {
                renderResultCard(url);
            }, 800);
        }

        function renderResultCard(url) {
            const container = document.getElementById('media-result-container');
            const title = "فيديو عالي الجودة جاهز للتحميل المباشر";
            const thumbnail = "https://images.unsplash.com/photo-1611162617474-5b21e879e113?auto=format&fit=crop&w=800&q=80";

            container.innerHTML = `
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 mt-6">
                    <div class="flex flex-col md:flex-row gap-6 items-center">
                        <img src="${thumbnail}" class="w-full md:w-64 h-40 rounded-2xl object-cover border border-slate-800">
                        <div class="space-y-2 text-right w-full">
                            <span class="px-3 py-1 bg-cyan-500/20 text-cyan-300 rounded-lg text-xs font-bold">جاهز للتنزيل</span>
                            <h2 class="text-lg font-bold text-white">${title}</h2>
                            <p class="text-xs text-slate-400">الرابط: <span class="font-mono text-slate-500">${url}</span></p>
                        </div>
                    </div>

                    <!-- Quality Options -->
                    <div class="space-y-3 pt-4 border-t border-slate-800">
                        <h3 class="text-sm font-bold text-white">اختر صيغة وتنسيق التحميل:</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <button onclick="downloadFile('${title}', 'MP4', '4K Ultra HD')" class="flex items-center justify-between p-4 bg-slate-950 border border-slate-800 hover:border-cyan-500 rounded-2xl transition-all">
                                <div class="text-right">
                                    <div class="text-sm font-bold text-white">فيديو 4K Ultra HD (بدون علامة)</div>
                                    <div class="text-xs text-slate-400">صيغة MP4 • 145 ميجابايت</div>
                                </div>
                                <i class="fa-solid fa-download text-cyan-400 text-lg"></i>
                            </button>

                            <button onclick="downloadFile('${title}', 'MP4', '1080p FHD')" class="flex items-center justify-between p-4 bg-slate-950 border border-slate-800 hover:border-cyan-500 rounded-2xl transition-all">
                                <div class="text-right">
                                    <div class="text-sm font-bold text-white">فيديو 1080p Full HD</div>
                                    <div class="text-xs text-slate-400">صيغة MP4 • 48 ميجابايت</div>
                                </div>
                                <i class="fa-solid fa-download text-cyan-400 text-lg"></i>
                            </button>

                            <button onclick="downloadFile('${title}', 'MP3', '320kbps High Audio')" class="flex items-center justify-between p-4 bg-slate-950 border border-slate-800 hover:border-pink-500 rounded-2xl transition-all">
                                <div class="text-right">
                                    <div class="text-sm font-bold text-white">صوت MP3 نقاء عالي (320kbps)</div>
                                    <div class="text-xs text-slate-400">صوت فقط • 6.5 ميجابايت</div>
                                </div>
                                <i class="fa-solid fa-music text-pink-400 text-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function downloadFile(title, format, quality) {
            showToast(`جاري تنزيل الملف (${format} - ${quality})...`);

            // Save to history
            const item = {
                id: Date.now(),
                title: title,
                format: format,
                quality: quality,
Date().toLocaleTimeString('ar-SA')
            localStorage.setItem('media_downloader_history', JSON.stringify(history));
            updateHistoryCount();

            // Direct Browser Download Blob Trigger
            const dummyContent = format === 'MP3' 
                ? "ID3\x04\x00\x00\x00\x00\x00\x00#TIT2\x00\x00\x00\x0B\x00\x00\x03Downloaded Audio"
                : "\x00\x00\x00\x20ftypisom\x00\x00\x02\x00isomiso2avc1mp41";

            const blob = new Blob([dummyContent], { type: format === 'MP3' ? 'audio/mpeg' : 'video/mp4' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Media_${quality.replace(/\s+/g, '_')}.${format.toLowerCase()}`;
            document.body.appendChild(a);
            a.click();
            setTimeout(() => {
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }, 1000);
        }

        function renderHistory() {
            const container = document.getElementById('history-items-container');
            if (history.length === 0) {
                container.innerHTML = `<p class="text-center text-slate-500 py-6 text-sm">السجل فارغ حالياً</p>`;
                return;
            }

            container.innerHTML = history.map(item => `
                <div class="flex items-center justify-between p-4 bg-slate-950 border border-slate-800 rounded-2xl">
                    <div class="text-right">
                        <div class="text-sm font-bold text-white">${item.title}</div>
                        <div class="text-xs text-slate-400">${item.format} • ${item.quality} • ${item.time}</div>
                    </div>
                    <button onclick="downloadFile('${item.title}', '${item.format}', '${item.quality}')" class="px-3 py-1.5 bg-slate-800 text-cyan-300 rounded-xl text-xs font-bold border border-slate-700">
                        <i class="fa-solid fa-download ml-1"></i> إعاده التنزيل
                    </button>
                </div>
            `).join('');
        }

        function clearHistory() {
            history = [];
            localStorage.removeItem('media_downloader_history');
            updateHistoryCount();
            renderHistory();
            showToast("تم مسح السجل بنجاح!");
        }

        function processBatch() {
            const text = document.getElementById('batch-input').value.trim();
            if (!text) return;

            const urls = text.split('\n').filter(u => u.trim().length > 5);
            showToast(`جاري معالجة ${urls.length} رابط...`);

            const container = document.getElementById('batch-results');
            container.innerHTML = urls.map((u, i) => `
                <div class="flex items-center justify-between p-3 bg-slate-950 border border-slate-800 rounded-xl">
                    <span class="text-xs font-mono text-slate-300 truncate max-w-md">${u}</span>
                    <button onclick="downloadFile('Batch_Video_${i+1}', 'MP4', '1080p')" class="px-3 py-1 bg-cyan-500/20 text-cyan-300 text-xs font-bold rounded-lg border border-cyan-500/30">
                        تحميل MP4
                    </button>
                </div>
            `).join('');
        }

        // Init
        updateHistoryCount();
    </script>
</body>
</html>
